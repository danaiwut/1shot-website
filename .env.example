# Public site URL (used for auth email redirects and Telegram links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Google sign-in — Google Cloud → Google Auth Platform → Clients → OAuth client (Web application)
#   Authorized redirect URIs: {SITE_URL}/auth/google/callback  (one per site URL, e.g. localhost and production)
#   Supabase → Authentication → Sign In / Providers → Google must stay enabled with this Client ID
#   (Supabase only verifies the ID token; the user never visits supabase.co).
GOOGLE_CLIENT_ID=
# Server only.
GOOGLE_CLIENT_SECRET=

# TradingView alerts → POST {SITE_URL}/api/webhook/tradingview/{TRADINGVIEW_WEBHOOK_SECRET}
TRADINGVIEW_WEBHOOK_SECRET=generate-a-long-random-string

# Telegram gate bot (pairing + room invites)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token (setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=generate-another-long-random-string

# Stripe — Developers → API keys (use sk_test_… while testing)
STRIPE_SECRET_KEY=
# Developers → Webhooks → endpoint {SITE_URL}/api/stripe/webhook → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Customer emails (purchase / renewal / refund) via Resend — resend.com → API Keys; verify your domain first.
RESEND_API_KEY=
# e.g. 1SHOT Signals <billing@yourdomain.com>
EMAIL_FROM=
EMAIL_REPLY_TO=

# First admin: these emails become owner automatically after they sign up (comma-separated)
OWNER_EMAILS=

# Exness partner API — daily lot sync (src/lib/exness.ts; adjust requestVolumes() to your endpoint)
EXNESS_API_URL=
EXNESS_API_TOKEN=
# Automatic IB check (is this trading account under our IB?). Exness partner area login.
EXNESS_PARTNER_LOGIN=
EXNESS_PARTNER_PASSWORD=
# EXNESS_AFFILIATES_URL=https://my.exnessaffiliates.com
# Vercel Cron → /api/cron/exness sends "Authorization: Bearer <CRON_SECRET>" (any long random string)
CRON_SECRET=

# TradingView invite-only access, automated after payment (src/lib/tradingview.ts).
# Cookie values from the script OWNER's logged-in TradingView browser session (DevTools › Application › Cookies).
# Treat like a password: server only, rotate by logging out of TradingView.
TRADINGVIEW_SESSIONID=
TRADINGVIEW_SESSIONID_SIGN=
